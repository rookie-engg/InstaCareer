# Start from the official Ollama image
FROM ollama/ollama

# Switch to the root user to be able to install packages
USER root

# ✅ CORRECTED: Install curl, which is needed by the entrypoint script.
# - apt-get update: Refreshes the package list from the repositories.
# - apt-get install -y curl: Installs the curl package without asking for confirmation.
# - rm -rf /var/lib/apt/lists/*: Cleans up the apt cache to keep the final image size smaller.
RUN apt-get update && \
    apt-get install -y curl && \
    rm -rf /var/lib/apt/lists/*

# Copy the custom entrypoint script into the image
COPY entrypoint.sh /entrypoint.sh

# Make the script executable
RUN chmod +x /entrypoint.sh

# Set the custom script as the entrypoint for the container
ENTRYPOINT ["/entrypoint.sh"]
